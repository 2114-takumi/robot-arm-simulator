<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="two_link_arm">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import two_link_arm urdf file -->
    <xacro:include filename="$(find robot_arm_ros)/urdf/two_link_arm.urdf" />

    <!-- Import control_xacro -->
    <xacro:include filename="two_link_arm.ros2_control.xacro" />


    <xacro:two_link_arm_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>

</robot>
